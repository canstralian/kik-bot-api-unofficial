# Copy to .env (ignored by git). Supply a dedicated bot account.
# Never publish credentials, derived passkeys, device IDs, session stanzas or attestation tokens.
BOT_USERNAME=
BOT_PASSWORD=
# Optional stable identifiers for your own bot account; empty values are generated per process.
DEVICE_ID=
ANDROID_ID=
BOT_NODE_JID=
# Optional documented Kik-controlled hostname override (no URL, IP or third-party domain).
# Setting this does not guarantee successful authentication.
KIK_HOST=

# Governed command application (examples/governed_bot.py). OFF by default.
KIK_LIVE_ENABLED=0
# Only these complete Kik group JIDs are allowed; comma-separated, no wildcard.
KIK_ALLOWED_GROUP_JIDS=
KIK_PM_ENABLED=0
# Database file is local and untracked.
KIK_BOT_DB=bot_sessions.sqlite3
# The governed live example requires BOT_NODE_JID above for self filtering.
